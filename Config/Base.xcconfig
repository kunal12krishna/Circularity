#include "Identity.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 13.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Universal binary (arm64 + x86_64). Debug builds only the active arch.
ARCHS = arm64 x86_64
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Where the opt-in update check looks for appcast.json (https only). Empty = no
// update checks in this build. See docs/UPDATES.md.
UPDATE_FEED_URL =

// Ad-hoc signing with hardened runtime (see PLAN.md §0 and BRIEF.md decision 2).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES

// Size: strip dead code and symbols from installed products.
DEAD_CODE_STRIPPING = YES

CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
